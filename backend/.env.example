# Copy to backend/.env for local development. Never commit real secrets.
# Production API DATABASE_URL must use a non-owner, non-superuser runtime role.
# Supply a separate migration-role DATABASE_URL only to protected Alembic
# release commands; do not configure migration credentials in the API service.
# See docs/public/POSTGRESQL_SECURITY.md before creating or changing database roles.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5432/placementpilot
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development

# Local development stores resumes under backend/storage/resumes.
RESUME_STORAGE_BACKEND=local

# Production S3-compatible storage (for example, Cloudflare R2). Keep these
# values secret and configure the bucket to deny anonymous/public reads.
# Set RESUME_STORAGE_BACKEND=s3 in the production host environment.
# S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_BUCKET_NAME=placementpilot-private-resumes
# S3_ACCESS_KEY_ID=YOUR_BUCKET_SCOPED_ACCESS_KEY_ID
# S3_SECRET_ACCESS_KEY=YOUR_BUCKET_SCOPED_SECRET_ACCESS_KEY
# S3_REGION=auto
